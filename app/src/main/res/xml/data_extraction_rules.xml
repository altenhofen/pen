<?xml version="1.0" encoding="utf-8"?><!--
    Android 12 and newer. Cloud backup carries the motor sliders only. The prototype clusters and
    word samples are a model of how one person's hand moves, so they never leave the device except
    through an export the user has locked with a passphrase. Device-to-device transfer is a direct
    handset-to-handset copy with no server in between, so it carries everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/motor_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/motor_settings.preferences_pb" />
        <include domain="database" path="prototypes.db" />
        <include domain="database" path="prototypes.db-wal" />
        <include domain="database" path="prototypes.db-shm" />
    </device-transfer>
</data-extraction-rules>
